# ---- copy to .env and fill in. Never commit .env ----
POSTGRES_USER=ttq
POSTGRES_PASSWORD=change-this-db-password
POSTGRES_DB=ttq

TTQ_ENV=production
# Login for the single operator account. Prefer a bcrypt hash:
#   docker compose run --rm api python -m ttq.cli hash-password --password 'your-password'
TTQ_ADMIN_USERNAME=admin
TTQ_ADMIN_PASSWORD_HASH=
TTQ_ADMIN_PASSWORD=change-me
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
TTQ_JWT_SECRET=change-this-secret
TTQ_CORS_ORIGINS=http://localhost:3000
TTQ_USER_TIMEZONE=America/New_York
TTQ_USER_REGION=US-FL
TTQ_MAX_QUOTE_AGE_SECONDS=600
# DEMO synthetic world (clearly labelled). Set false once a licensed live source is configured.
TTQ_ENABLE_DEMO=true

# ---- Data providers (optional; unset => adapter UNAVAILABLE) ----
# The Odds API: TT Elite coverage NOT verified. Run Data Sources -> "Discover" first, then set the sport key.
TTQ_THE_ODDS_API_KEY=
TTQ_THE_ODDS_API_SPORT_KEY=

# ---- Alerts (optional) ----
TTQ_SMTP_HOST=
TTQ_SMTP_PORT=587
TTQ_SMTP_USER=
TTQ_SMTP_PASSWORD=
TTQ_ALERT_EMAIL_FROM=
TTQ_ALERT_EMAIL_TO=
TTQ_TELEGRAM_BOT_TOKEN=
TTQ_TELEGRAM_CHAT_ID=

NEXT_PUBLIC_API_URL=http://localhost:8000
